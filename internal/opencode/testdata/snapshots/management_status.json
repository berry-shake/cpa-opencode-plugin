          "ok": true,
          "result": {
            "routes": [
              {
                "method": "GET",
                "path": "/v0/management/plugins/opencode/status",
                "description": "Plugin status, model catalog summary and OpenCode credentials."
              },
              {
                "method": "GET",
                "path": "/v0/management/plugins/opencode/models",
                "description": "OpenCode model list with inputs, tools, reasoning efforts, context length and prices."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/opencode/models/refresh",
                "description": "Reload the OpenCode model catalog and re-register changed models."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/opencode/credentials",
                "description": "Add an OpenCode API key. Body: {\"api_key\",\"label\",\"note\",\"models\",\"prefix\",\"proxy_url\"|\"proxy_id\"}."
              },
              {
                "method": "PATCH",
                "path": "/v0/management/plugins/opencode/credentials",
                "description": "Edit an OpenCode credential. Body: {\"auth_index\",\"label\",\"note\",\"models\",\"prefix\",\"proxy_url\"|\"proxy_id\",\"priority\"}."
              },
              {
                "method": "GET",
                "path": "/v0/management/plugins/opencode/credentials/quota",
                "description": "Go allowance (5-hour, weekly and monthly usage) of the OpenCode workspace behind one credential (?auth_index=)."
              },
              {
                "method": "GET",
                "path": "/v0/management/plugins/opencode/logs",
                "description": "Request log, newest first (?search=&status=all|success|error&from=&to=&request_id=&limit=&offset=), with a summary."
              },
              {
                "method": "DELETE",
                "path": "/v0/management/plugins/opencode/logs",
                "description": "Clear the request log."
              },
              {
                "method": "GET",
                "path": "/v0/management/plugins/opencode/proxies",
                "description": "Proxy list (URLs redacted) and CPA's global proxy."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/opencode/proxies",
                "description": "Add a proxy. Body: {\"name\",\"url\"}."
              },
              {
                "method": "PATCH",
                "path": "/v0/management/plugins/opencode/proxies",
                "description": "Rename a proxy or change its URL. Body: {\"id\",\"name\",\"url\"}. Credentials using the old URL move to the new one."
              },
              {
                "method": "DELETE",
                "path": "/v0/management/plugins/opencode/proxies",
                "description": "Remove a proxy (?id=). Credentials using it keep its URL."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/opencode/proxies/import",
                "description": "Add the proxies OpenCode credentials already use to the list."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/opencode/proxies/order",
                "description": "Reorder the proxy list. Body: {\"ids\":[...]}."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/opencode/proxies/check",
                "description": "Look up the exit IP and latency of a proxy. Body: {\"id\"} or {\"target\":\"direct\"|\"inherit\"}."
              }
            ],
            "resources": [
              {
                "path": "/manage",
                "menu": "OpenCode",
                "description": "Manage OpenCode API keys, model selection and egress proxies."
              },
              {
                "path": "/logo.svg",
                "description": "Plugin logo served to the management panel sidebar."
              },
              {
                "path": "/flag.svg",
                "description": "Country flag icon for egress checks (?cc=<ISO 3166-1 alpha-2>)."
              }
            ]
          }
        }
