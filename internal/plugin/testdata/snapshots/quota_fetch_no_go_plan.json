{
  "case": "quota_fetch_no_go_plan",
  "description": "A 403 from Go usage means no Go plan: an empty quota, cached",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}/inference/go",
      "data-dir": "{{DATA_DIR}}",
      "enabled": true,
      "priority": 0
    },
    "credentials": [
      {
        "name": "opencode-k1.json",
        "fields": {
          "api_key": "oc_sk_test_fake_key_0001",
          "type": "opencode"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/zen/go/v1/usage",
      "status": 403,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"type\":\"error\",\"error\":{\"type\":\"ForbiddenError\",\"message\":\"Workspace has no Go subscription\"}}",
      "chunks": []
    }
  ],
  "steps": [
