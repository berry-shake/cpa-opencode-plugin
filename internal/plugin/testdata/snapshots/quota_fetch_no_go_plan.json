          "auth_index": "idx-1",
          "auth_id": "opencode-k1.json",
          "provider": "opencode",
          "storage_json": {
            "api_key": "oc_sk_test_fake_key_0001",
            "type": "opencode"
          },
          "metadata": {
            "api_key": "oc_sk_test_fake_key_0001",
            "type": "opencode"
          },
          "host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "host-callback-1"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/zen/go/v1/usage",
